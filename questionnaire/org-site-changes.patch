+<title>שאלון למצפוני קבוצות · תל אביב-יפו</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@700;800&family=Heebo:wght@400;500;700&display=swap">
+<style>
+  :root {
+    --bg: #E3EFEE;
+    --card: #FFFFFF;
+    --shadow: #B3CFCC;
+    --navy: #0E5458;
+    --navy-soft: #176A6E;
+    --heading: #0E5458;
+    --text: #2A2F36;
+    --muted: #6B7480;
+    --line: #C6D8D6;
+    --teal: #1A4F80;
+    --teal-soft: #EAF1F8;
+    --teal-ink: #163F68;
+    --gold: #E9C26A;
+    --btn: #0E6A6F;
+    --error: #B3261E;
+    color-scheme: light;
+  }
+  * { box-sizing: border-box; }
+  [hidden] { display: none !important; }
+  html, body { margin: 0; }
+  body {
+    background: var(--bg);
+    color: var(--text);
+    font: 400 17px/1.75 "Heebo", "Arial Hebrew", Arial, sans-serif;
+    padding: 24px 16px 40px;
+  }
+  .wrap { max-width: 620px; margin: 0 auto; display: grid; gap: 28px; }
+
+  /* כרטיס בסגנון העלון */
+  .card {
+    background: var(--card);
+    border-top: 8px solid var(--teal);
+    box-shadow: 12px 12px 0 var(--shadow);
+    padding: 40px 28px 44px;
+    display: grid;
+    gap: 22px;
+  }
+  .card.cover {
+    background: var(--navy);
+    border-top-color: var(--gold);
+    color: #fff;
+    text-align: center;
+  }
+  .eyebrow { color: #A8E0DC; font-size: 15px; }
+  h1, h2 {
+    font-family: "Assistant", "Heebo", Arial, sans-serif;
+    font-weight: 800;
+    line-height: 1.25;
+    margin: 0;
+    text-wrap: balance;
+  }
+  h1 { font-size: clamp(34px, 9vw, 46px); }
+  h2 { font-size: 26px; color: var(--heading); }
+  .subtitle { font-size: 20px; margin: -6px 0 0; }
+  p { margin: 0; }
+  .note { color: var(--muted); font-size: 14px; line-height: 1.6; }
+  .cover .note { color: #C4E0DE; }
+
+  .quote {
+    background: var(--teal-soft);
+    border-right: 4px solid var(--teal);
+    border-radius: 4px;
+    padding: 16px 20px;
+    color: var(--teal-ink);
+    font-family: "Assistant", "Heebo", Arial, sans-serif;
+    font-weight: 700;
+    font-size: 19px;
+    line-height: 1.55;
+  }
+  .cover .quote {
+    background: var(--navy-soft);
+    border-right-color: var(--gold);
+    color: var(--gold);
+    text-align: right;
+  }
+
+  /* שדות */
+  .field { display: grid; gap: 10px; border: 0; margin: 0; padding: 0; min-width: 0; }
+  .label { font-weight: 700; color: var(--text); font-size: 17px; line-height: 1.5; padding: 0; }
+  .req { color: var(--teal); }
+  .hint { color: var(--muted); font-size: 14px; margin-top: -6px; }
+  input[type=text], input[type=time], textarea {
+    width: 100%;
+    font: inherit;
+    color: var(--text);
+    background: #fff;
+    border: 1.5px solid var(--line);
+    border-radius: 6px;
+    padding: 10px 12px;
+  }
+  textarea { min-height: 110px; resize: vertical; }
+  input:focus-visible, textarea:focus-visible, button:focus-visible, .opt:focus-within {
+    outline: 3px solid rgba(14, 106, 111, .35);
+    outline-offset: 2px;
+  }
+  .opts { display: grid; gap: 8px; }
+  .opts.days { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); }
+  .opt {
+    display: flex; align-items: flex-start; gap: 10px;
+    border: 1.5px solid var(--line);
+    border-radius: 6px;
+    padding: 10px 12px;
+    cursor: pointer;
+    line-height: 1.5;
+    background: #fff;
+  }
+  .opt input { accent-color: var(--teal); width: 18px; height: 18px; margin: 3px 0 0; flex: none; }
+  .opt:has(input:checked) { border-color: var(--teal); background: var(--teal-soft); color: var(--teal-ink); font-weight: 500; }
+  .other-text { margin-top: 4px; }
+  .err { color: var(--error); font-size: 14px; font-weight: 500; }
+  .field.invalid .opt, .field.invalid input[type=text] { border-color: var(--error); }
+
+  /* ניווט */
+  .nav {
+    display: flex; align-items: center; justify-content: space-between; gap: 12px;
+    border-top: 1px solid var(--line);
+    padding-top: 20px;
+  }
+  .btn {
+    font: 700 18px "Heebo", Arial, sans-serif;
+    min-width: 120px;
+    padding: 12px 20px;
+    border-radius: 6px;
+    cursor: pointer;
+    border: 1.5px solid var(--btn);
+  }
+  .btn.primary { background: var(--btn); color: #fff; }
+  .btn.ghost { background: #fff; color: var(--btn); border-color: var(--line); }
+  .btn:disabled { opacity: .45; cursor: default; }
+  .counter { color: var(--heading); font-variant-numeric: tabular-nums; font-size: 17px; direction: ltr; }
+
+  .links { display: grid; gap: 12px; }
+  .link-btn {
+    display: block; text-align: center; text-decoration: none;
+    font-weight: 700; font-size: 18px;
+    padding: 14px 18px; border-radius: 6px;
+  }
+  .link-btn.wa { background: var(--gold); color: var(--navy); }
+  .link-btn.leaf { border: 1.5px solid #BFDCD9; color: #fff; }
+  .status { text-align: center; color: var(--muted); font-size: 15px; }
+
+  @media (max-width: 420px) {
+    .card { padding: 32px 20px 36px; box-shadow: 8px 8px 0 var(--shadow); }
+    .btn { min-width: 96px; }
+  }
+  @media (prefers-reduced-motion: no-preference) {
+    .card { animation: in .25s ease-out; }
+    @keyframes in { from { transform: translateY(6px); } to { transform: none; } }
+  }
+</style>
+</head>
